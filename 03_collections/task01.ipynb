   "source": [
    "grades = [85, 90, 78, 92, 88]\n",
    "\n",
    "average =  sum(grades)/len(grades)\n",
    "\n",
    "mx = max(grades)\n",
    "mn = min(grades)\n",
    "\n",
    "above_average = sum(True for g in grades if g >= average)\n",
    "\n",
    "print(f\"平均点：{average}\")\n",
    "print(f\"最高点：{mx}\")\n",
    "print(f\"最低点：{mn}\")\n",
    "print(f\"平均以上の学生数：{above_average}\")"
   ]
  }
 ],
